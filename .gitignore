.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Per-date P-MLE parameter files. A daily 2007-2026 run writes ~5,100 of these,
# one small CSV per valuation date. They are intermediate output: the assembled
# series poc/systematic_params.csv is the thing worth committing, and it is
# regenerable from these in seconds.
#
# The paper repository commits its 37 files deliberately, as part of a
# replication package. Five thousand is a different proposition - it makes every
# clone, diff and status slow for no benefit.
Study/Estimated Parameters PMLE/
!poc/systematic_params.csv

# Monte-Carlo ES ladder cache written by poc/autocallable_stress.py.
# Regenerable in a minute; one file per (vintage, alpha, horizon set).
poc/_es_ladder_cache/

# Archived PMLE stores. The store is moved aside rather than deleted when it
# is rebuilt from scratch, so a drawer that produced a reported table stays
# readable with its manifest. The live path below is ignored by name, so an
# archive under any other name would otherwise show up as several thousand
# untracked files and disable half the IDE.
Study/PMLE __archived_*/
Study/*__archived_*/
